# Neon pooled connection (has -pooler in the hostname) — used by the application
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Neon direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Used by integration tests (tests/integration). Prefer a separate Neon branch if you
# have console/API access; otherwise these can point at the same database with a
# "schema" query parameter — see docs/implementation/02-database.md.
# Not needed on Vercel.
TEST_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=test_isolation"
TEST_DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&schema=test_isolation"

# openssl rand -base64 32 — generate a different secret for production
BETTER_AUTH_SECRET="replace-me"
# Local: http://localhost:3000
# Production: the canonical Vercel origin, e.g. https://orders-and-settlements.vercel.app
# (no trailing slash). Can be omitted on the first deploy; the app falls back to VERCEL_URL.
BETTER_AUTH_URL="http://localhost:3000"
